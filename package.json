{
  "name": "@bagandev/doc-layouts",
  "version": "0.1.0",
  "description": "Layouts for Docs Template",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "susee build",
    "lint": "biome check src --write",
    "fmt": "biome format --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bagandev/doc-layouts.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/bagandev/doc-layouts/issues"
  },
  "homepage": "https://github.com/bagandev/doc-layouts#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "susee": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
